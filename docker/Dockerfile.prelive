# Build context must be the TradingAI/ repo root (requirements.txt pulls in
# ../shared, ../strategy-service, ../options-service, ../backtesting-service), e.g.:
#   docker build -f docker/Dockerfile.prelive -t tradingai-prelive .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY shared ./shared
COPY broker-clients ./broker-clients
COPY strategy-service ./strategy-service
COPY risk-service ./risk-service
COPY options-service ./options-service
COPY backtesting-service ./backtesting-service
COPY prelive-service ./prelive-service

WORKDIR /app/prelive-service
RUN pip install --no-cache-dir -r requirements.txt

CMD ["python", "main.py"]
