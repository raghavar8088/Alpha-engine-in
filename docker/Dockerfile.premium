# Premium Strategies paper desk. Build context is the repo root, e.g.:
#   docker build -f docker/Dockerfile.premium -t tradingai-premium .
# It carries only the studies' strategy code and the app's index-minute cleaner, unchanged and at the same relative
# paths as in the repo, so a paper trade comes from the code that produced the backtest. No broker client is installed.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV MALLOC_ARENA_MAX=2

WORKDIR /app/premium-paper-service
COPY premium-paper-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/research/booming_bulls_2026_11/bb_markets.py backend/research/booming_bulls_2026_11/bb_engine.py backend/research/booming_bulls_2026_11/bb_strategies.py /app/backend/research/booming_bulls_2026_11/
COPY backend/research/youtube_top20_2026_11/yt_markets.py backend/research/youtube_top20_2026_11/yt_engine.py backend/research/youtube_top20_2026_11/yt_strategies.py backend/research/youtube_top20_2026_11/yt_ind.py /app/backend/research/youtube_top20_2026_11/
COPY backend/research/crypto_playlist_2026_11/cp_markets.py backend/research/crypto_playlist_2026_11/cp_strategies.py /app/backend/research/crypto_playlist_2026_11/
# The 11-channel strategies: their rules, indicators, fill engine and book runner (the code the look-ahead checks ran).
COPY backend/research/youtube_channels11_2026_11/yc_common.py backend/research/youtube_channels11_2026_11/yc_ind.py backend/research/youtube_channels11_2026_11/yc_engine.py backend/research/youtube_channels11_2026_11/yc_nj_india.py backend/research/youtube_channels11_2026_11/yc_nj_crypto.py backend/research/youtube_channels11_2026_11/yc_channels.py backend/research/youtube_channels11_2026_11/yc_more.py backend/research/youtube_channels11_2026_11/yc_strategies.py backend/research/youtube_channels11_2026_11/yc_run.py /app/backend/research/youtube_channels11_2026_11/
# The 20-channel strategies (registered into the 11-channel registry by zc_strategies; run by the same yc_run).
COPY backend/research/youtube_channels20_2026_11/zc_common.py backend/research/youtube_channels20_2026_11/zc_india.py backend/research/youtube_channels20_2026_11/zc_global_a.py backend/research/youtube_channels20_2026_11/zc_global_b.py backend/research/youtube_channels20_2026_11/zc_strategies.py /app/backend/research/youtube_channels20_2026_11/
COPY backend/app/services/index_intraday/data.py /app/backend/app/services/index_intraday/data.py
# The liquidity-sweep books run the app's own strategy classes (liquidity_sweep.py): the shared domain/contracts package and
# the three strategy files they import. These are not the library's package __init__s, which import every strategy.
COPY shared/tradingai_shared /app/shared/tradingai_shared
COPY strategy-service/strategy_service/indicators.py /app/strategy-service/strategy_service/indicators.py
COPY strategy-service/strategy_service/strategies/options_buying/_base.py strategy-service/strategy_service/strategies/options_buying/booming_bulls.py strategy-service/strategy_service/strategies/options_buying/booming_bulls_sweep_versions.py /app/strategy-service/strategy_service/strategies/options_buying/
COPY premium-paper-service/*.py ./

CMD ["python", "main.py"]
